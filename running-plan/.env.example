# ─── Frontend (Vite) — the NEW running-plan Firebase project's web config ───
# Get these from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Offline demo mode: skips Firebase auth and stores data in localStorage.
# VITE_DEMO=1

# ─── Backend secrets ────────────────────────────────────────────────────────
# These belong in running-plan/functions/.env (NOT here — Vite would expose
# anything it bundles). The dev-server.cjs also reads them from this file locally.
# ANTHROPIC_API_KEY=your_api_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# STRAVA_CLIENT_ID=your_strava_client_id
# STRAVA_CLIENT_SECRET=your_strava_client_secret
# WHOOP_CLIENT_ID=your_whoop_client_id
# WHOOP_CLIENT_SECRET=your_whoop_client_secret

# Offline mock modes for the dev server (dev-server.cjs):
# MOCK_AI=1
# STRAVA_MOCK=1
# WHOOP_MOCK=1
