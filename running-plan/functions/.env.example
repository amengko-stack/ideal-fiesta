# Cloud Functions secrets for the running-plan API (copy to functions/.env).
# firebase-functions v4 loads functions/.env automatically at deploy time.
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional — enable the Strava "Connect" button in production.
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Optional — enable the WHOOP "Connect" button in production.
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret
