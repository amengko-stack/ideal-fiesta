# Firebase configuration — copy from your Firebase project settings
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Firebase Console setup required ───────────────────────────────────────
# 1. Authentication > Sign-in method > Email link (passwordless) → Enable
# 2. Authentication > Settings > Authorized domains → add your Netlify domain
# 3. Firestore Database → Create database (production mode)
# 4. Firestore Rules (paste in Firebase Console):
#
#   rules_version = '2';
#   service cloud.firestore {
#     match /databases/{database}/documents {
#       match /family_members/{docId} {
#         // Anyone can create a pending submission (must be authenticated via email link)
#         allow create: if request.auth != null
#                       && request.resource.data.status == 'pending'
#                       && request.resource.data.email == request.auth.token.email;
#         // Approved members are public (for the world map)
#         allow read: if resource.data.status == 'approved';
#         // Admin can read/write everything
#         allow read, write: if request.auth != null
#                            && request.auth.token.email == 'allova@mengko.com';
#       }
#     }
#   }
