# ── Anthropic / Claude ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here
# Use a vision-capable model (haiku is fast and cheap, sonnet is higher quality)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1024

# ── Google Drive folder IDs ────────────────────────────────────────────────────
# Open each folder in Drive → copy the ID from the URL:
# https://drive.google.com/drive/folders/<FOLDER_ID_IS_HERE>
DRIVE_INBOX_FOLDER_ID=
DRIVE_PROCESSING_FOLDER_ID=
DRIVE_READY_FOLDER_ID=
DRIVE_ARCHIVE_FOLDER_ID=
DRIVE_ERRORS_FOLDER_ID=

# ── Google Auth (Service Account) ─────────────────────────────────────────────
# Option A (recommended for Cloud Run): paste the full service-account.json content here.
# Get it from: GCP Console → IAM → Service Accounts → your SA → Keys → Add Key → JSON
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B (local dev): path to the downloaded key file.
# GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# ── Processing behaviour ───────────────────────────────────────────────────────
# How often to check Drive Inbox (milliseconds). Default: 30 seconds.
POLL_INTERVAL_MS=30000
# Max files to process in parallel
MAX_CONCURRENT_JOBS=2
# Videos longer than this will be trimmed (seconds)
MAX_VIDEO_DURATION_SEC=90
# Default image filter: warm | cool | vibrant | matte | natural
DEFAULT_IMAGE_FILTER=natural
# Background music volume relative to original audio (0.0 = silent, 1.0 = equal)
MUSIC_VOLUME=0.3
# Directory containing .mp3 background music tracks (add your own licensed tracks)
# NOTE: Replace placeholder tracks with properly licensed music before production use.
MUSIC_DIR=/app/music
# Font file for text overlays
FONT_PATH=/app/fonts/Montserrat-Bold.ttf

# ── HTTP health check (Cloud Run requires a listening port) ────────────────────
PORT=8080
